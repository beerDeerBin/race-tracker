{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Persistence": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Port": 5672,
      "VirtualHost": "race-tracker",
      "Username": "race",
      "Password": "race"
    },
    "Timescale": {
      "Host": "timescaledb",
      "Port": 5432,
      "Database": "racetracker",
      "Username": "race",
      "Password": "race"
    },
    "Consumer": {
      "Queue": "rt.persistence.samples",
      "BindingKey": "#",
      "DeadLetterExchange": "rt.persistence.dlx",
      "DeadLetterQueue": "rt.persistence.dlq",
      "Prefetch": 32
    }
  },
  "Auth": {
    "Jwt": {
      "//": "Must match the management issuer's parameters (story 7.5). Override via Auth__Jwt__SigningKey in real deployments.",
      "SigningKey": "dev-only-insecure-signing-key-override-in-production-0123456789",
      "Issuer": "race-tracker-management",
      "Audience": "race-tracker"
    }
  },
  "Cors": {
    "//": "SPA origins allowed to call /graphql (story 7.1). Override via Cors__AllowedOrigins__0.",
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "AllowedHosts": "*"
}
