# Race-tracker local dev stack (all driven through the MQTT broker).
#
# Tilt web UI tips:
#   • Every resource has an enable/disable toggle in the UI — use it to turn the
#     simulator, tester, or mqttx client on/off without editing anything.
#   • Open "Config Editor" under tooling to edit simulator/config.yaml in the browser.

# This stack is pure docker-compose — no Kubernetes. Tilt still guards command
# execution against unrecognized kube contexts; allow the local dev context so a
# machine whose current context is named "local" can run the stack.
allow_k8s_contexts('local')

# ── platform detection ────────────────────────────────────────────────────────
# os.environ['OS'] == 'Windows_NT' on Windows; unset or different on Linux/Mac.
_is_windows = os.environ.get('OS', '').lower() == 'windows_nt'
_python = 'python' if _is_windows else 'python3'

# ── seed config.yaml on first run ─────────────────────────────────────────────
# The simulator bind-mounts this file; if the source is missing Docker would
# create it as a directory instead of a file.
if _is_windows:
    local(
        'if not exist simulator\\config.yaml copy simulator\\config.example.yaml simulator\\config.yaml',
        quiet=True,
    )
else:
    local(
        'test -f simulator/config.yaml || cp simulator/config.example.yaml simulator/config.yaml',
        quiet=True,
    )

# Load the MQTT stack, the internal RabbitMQ broker and the backend services as one
# merged Compose project, so they share a network and services can reach both brokers.
docker_compose([
    './mqtt/docker-compose.yml',
    './rabbitmq/docker-compose.yml',
    './redis/docker-compose.yml',
    './gateway/docker-compose.yml',
    './persistence/docker-compose.yml',
    './management/docker-compose.yml',
    './realtime/docker-compose.yml',
])

# ── brokers ─────────────────────────────────────────────────────────────────
# Mosquitto = device transport (MQTT); RabbitMQ = internal service broker (AMQP).
dc_resource('mosquitto', labels=['broker'])

dc_resource(
    'rabbitmq',
    labels=['broker'],
    links=[link('http://localhost:15672', 'RabbitMQ Management')],
)

dc_resource(
    'mqttx-web',
    labels=['broker'],
    links=[link('http://localhost:8080', 'MQTT Client')],
    resource_deps=['mosquitto'],
)

# ── datastores ────────────────────────────────────────────────────────────────
# TimescaleDB (PostgreSQL): time-series store for samples + run metadata (TP-PERS).
dc_resource('timescaledb', labels=['datastore'])

# MongoDB: document store for the management domain entities (User/Vehicle, TP-MGMT).
dc_resource('mongodb', labels=['datastore'])

# Redis: key-value cache for the realtime notification TTL idempotency keys (TP-EVT, story 8.2).
dc_resource('redis', labels=['datastore'])

# ── services ──────────────────────────────────────────────────────────────────
# TP-GW: ingestion gateway. Readiness (/health/ready) gates on MQTT + RabbitMQ.
dc_resource(
    'gateway',
    labels=['services'],
    resource_deps=['mosquitto', 'rabbitmq'],
    links=[
        link('http://localhost:8081/health/ready', 'Gateway readiness'),
        link('http://localhost:8081/metrics', 'Gateway metrics'),
    ],
)

# TP-PERS: persistence service. Readiness (/health/ready) gates on RabbitMQ + Timescale;
# the service applies its own schema migrations at startup.
dc_resource(
    'persistence',
    labels=['services'],
    resource_deps=['rabbitmq', 'timescaledb'],
    links=[
        link('http://localhost:8082/health/ready', 'Persistence readiness'),
        link('http://localhost:8082/graphql', 'Persistence GraphQL'),
    ],
)

# TP-MGMT: management service. Readiness (/health/ready) gates on MongoDB + RabbitMQ + MQTT; it
# consumes status events from RabbitMQ for device discovery (story 5.4) and publishes commands to
# devices over MQTT (story 5.5).
dc_resource(
    'management',
    labels=['services'],
    resource_deps=['mongodb', 'rabbitmq', 'mosquitto'],
    links=[
        link('http://localhost:8083/health/ready', 'Management readiness'),
        link('http://localhost:8083/metrics', 'Management metrics'),
    ],
)

# TP-RT: realtime/notification service. Readiness (/health/ready) gates on RabbitMQ + Redis; it
# consumes status events and pushes them live to SignalR clients (group per vehicle, 6.1–6.3) and
# emits TTL-deduped rule notifications (story 8.2).
dc_resource(
    'realtime',
    labels=['services'],
    resource_deps=['rabbitmq', 'redis'],
    links=[
        link('http://localhost:8084/health/ready', 'Realtime readiness'),
        link('http://localhost:8084/metrics', 'Realtime metrics'),
    ],
)

# ── frontend ──────────────────────────────────────────────────────────────────
# TP-FE: the React SPA (story 7.1+), served by the Vite dev server on the host (not
# containerized in dev — mirrors the config-editor local_resource pattern). `cmd` keeps
# node_modules in sync with package.json before the server starts.
local_resource(
    'frontend',
    cmd='npm install --no-fund --no-audit',
    serve_cmd='npm run dev',
    dir='frontend',
    serve_dir='frontend',
    labels=['frontend'],
    links=[link('http://localhost:5173', 'Web SPA')],
    deps=['frontend/package.json'],
    resource_deps=['management', 'persistence', 'realtime'],
)

# ── simulator ─────────────────────────────────────────────────────────────────
dc_resource(
    'race-tracker-simulator',
    labels=['simulator'],
    resource_deps=['mosquitto'],
)

local_resource(
    'config-editor',
    serve_cmd='{} simulator/config_editor.py'.format(_python),
    labels=['simulator'],
    links=[link('http://localhost:5001', 'Config Editor')],
)

# ── tooling ───────────────────────────────────────────────────────────────────
dc_resource(
    'race-tracker-tester',
    labels=['tooling'],
    links=[link('http://localhost:5000', 'Data Viewer')],
    resource_deps=['mosquitto'],
)
