<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests may relax the warnings-as-errors gate (doc/CONVENTIONS.md §7). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Underscored Given_When_Then test names are the intended xUnit convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RaceTracker.Management.Infrastructure\RaceTracker.Management.Infrastructure.csproj" />
    <!-- The auth flow test hosts the real pipeline via WebApplicationFactory<Program>. -->
    <ProjectReference Include="..\..\src\RaceTracker.Management.Api\RaceTracker.Management.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
    <!-- Spins up a real MongoDB in a throwaway container for the connectivity-probe + auth tests. -->
    <PackageReference Include="Testcontainers.MongoDb" />
    <!-- Builds the real MongoClient handed to the connectivity probe / test host. -->
    <PackageReference Include="MongoDB.Driver" />
    <!-- In-memory TestServer hosting the real Program for the auth pipeline test (story 5.2). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Drives a real RabbitMQ broker (declare/bind/publish a status event) for the discovery test (5.4). -->
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="RabbitMQ.Client" />
    <!-- Subscribes to a real Mosquitto broker to assert the published command bytes (5.5). -->
    <PackageReference Include="MQTTnet" />
  </ItemGroup>

</Project>
