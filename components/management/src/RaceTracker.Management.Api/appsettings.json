{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Management": {
    "Mongo": {
      "Host": "mongodb",
      "Port": 27017,
      "Database": "racetracker",
      "Username": "",
      "Password": ""
    },
    "RabbitMq": {
      "Host": "rabbitmq",
      "Port": 5672,
      "VirtualHost": "race-tracker",
      "Username": "race",
      "Password": "race"
    },
    "Mqtt": {
      "Host": "mosquitto",
      "Port": 1883
    },
    "Discovery": {
      "Queue": "rt.management.discovery",
      "BindingKey": "#",
      "DeadLetterExchange": "rt.management.dlx",
      "DeadLetterQueue": "rt.management.dlq",
      "Prefetch": 32
    }
  },
  "Auth": {
    "Jwt": {
      "//": "Dev-only HMAC-SHA256 key (>= 32 chars). Override via Auth__Jwt__SigningKey in real deployments.",
      "SigningKey": "dev-only-insecure-signing-key-override-in-production-0123456789",
      "Issuer": "race-tracker-management",
      "Audience": "race-tracker",
      "TokenLifetimeMinutes": 60
    },
    "SeedUser": {
      "//": "Dev-only seed credentials (single-user /O20/). Override Auth__SeedUser__Password in real deployments.",
      "Username": "admin",
      "Password": "change-me",
      "Role": "admin"
    }
  },
  "AllowedHosts": "*"
}
