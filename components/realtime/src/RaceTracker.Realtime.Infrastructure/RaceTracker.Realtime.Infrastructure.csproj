<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters implementing the Application ports (/A30/). Depends on Application. -->

  <!-- The offline monitor's sweep step (story 8.4) is internal but unit-tested directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RaceTracker.Realtime.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaceTracker.Realtime.Application\RaceTracker.Realtime.Application.csproj" />
    <!-- Shared /S50/ message contracts: the relay deserializes StatusEvent off the broker. -->
    <ProjectReference Include="..\..\..\building-blocks\src\RaceTracker.BuildingBlocks.Contracts\RaceTracker.BuildingBlocks.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- /O80/: official low-level RabbitMQ client (decided in story 2.1). -->
    <PackageReference Include="RabbitMQ.Client" />
    <!-- Key-value cache for notification TTL idempotency (story 8.2, /O10/). -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Relational store for the transactional notification outbox (story 8.3, /F73/). -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- Service-owned outbox schema migrations, run once at startup (story 8.3). -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\Sql\*.sql" />
  </ItemGroup>

</Project>
