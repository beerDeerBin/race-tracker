{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Realtime": {
    "RabbitMq": {
      "Host": "rabbitmq",
      "Port": 5672,
      "VirtualHost": "race-tracker",
      "Username": "race",
      "Password": "race"
    },
    "Relay": {
      "BindingKey": "#",
      "Prefetch": 64
    },
    "Redis": {
      "Host": "redis",
      "Port": 6379,
      "NotificationTtlSeconds": 300
    },
    "Rules": {
      "//": "Story 8.4 (/O70/): offline after ~3 missed ~5s keepalives; swept every 5s.",
      "OfflineThresholdSeconds": 15,
      "OfflineSweepSeconds": 5
    },
    "Outbox": {
      "//": "Story 8.3: relational store for the transactional notification outbox. Override Host via Realtime__Outbox__Host.",
      "Host": "postgres",
      "Port": 5432,
      "Database": "racetracker",
      "Username": "race",
      "Password": "race",
      "DispatchPollSeconds": 2,
      "DispatchBatchSize": 50
    }
  },
  "Auth": {
    "Jwt": {
      "//": "Must match the management issuer's parameters (story 7.2). Override via Auth__Jwt__SigningKey in real deployments.",
      "SigningKey": "dev-only-insecure-signing-key-override-in-production-0123456789",
      "Issuer": "race-tracker-management",
      "Audience": "race-tracker"
    }
  },
  "Cors": {
    "//": "SPA origins allowed to reach the SignalR hub (story 7.1). Override via Cors__AllowedOrigins__0.",
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "AllowedHosts": "*"
}
