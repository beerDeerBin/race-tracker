<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Pin the package source so restores are reproducible regardless of any
       machine-global NuGet config. See doc/CONVENTIONS.md. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
